{
  "name": "leonid-pavlov",
  "version": "1.0.0",
  "private": true,
  "description": "Hugo static site: archive of Leonid Pavlov's poems and audio recordings",
  "scripts": {
    "dev": "hugo server",
    "dev:drafts": "hugo server --buildDrafts --buildFuture",
    "build": "hugo --gc --minify",
    "build:prod": "hugo --gc --minify --environment production",
    "preview": "hugo server --environment production",
    "clean": "rm -rf public resources",
    "lint": "stylelint \"assets/scss/**/*.scss\"",
    "lint:fix": "stylelint \"assets/scss/**/*.scss\" --fix"
  },
  "devDependencies": {
    "stylelint": "^16.15.0",
    "stylelint-config-standard-scss": "^14.0.0",
    "stylelint-scss": "^6.11.1"
  }
}
